<View>
  <Header value="ภาพสำหรับทำ Label"/>
  <Image
    name="image"
    value="$image"
    zoom="true"
    zoomControl="true"
    rotateControl="true"
  />

  <!-- ผลลัพธ์จริง -->
  <View style="padding:12px; border:1px solid #ddd; margin-bottom:12px;">
    <Header value="1. วาดหรือแก้ไข Mask ด้วยมือ"/>

    <BrushLabels name="label" toName="image">
      <Label value="person" background="#00B0FF"/>
      <Label value="helmet" background="#FF9800"/>
      <Label value="gloves" background="#8BC34A"/>
      <Label value="safety_vest" background="#FFEB3B"/>
      <Label value="safety_harness" background="#00BCD4"/>
      <Label value="safety_shoes" background="#795548"/>
      <Label value="employee_badge" background="#9C27B0"/>
      <Label value="house_number_sign" background="#4CAF50"/>
      <Label value="lat-long" background="#E91E63"/>
    </BrushLabels>
  </View>

  <!-- SAM แบบจุด -->
  <View style="padding:12px; border:1px solid #8BC34A; margin-bottom:12px;">
    <Header value="2. SAM: เลือกคลาสแล้วคลิกบนวัตถุ"/>

    <KeyPointLabels
      name="sam_point"
      toName="image"
      smart="true"
    >
      <Label value="person" background="#00B0FF" smart="true"/>
      <Label value="helmet" background="#FF9800" smart="true"/>
      <Label value="gloves" background="#8BC34A" smart="true"/>
      <Label value="safety_vest" background="#FFEB3B" smart="true"/>
      <Label value="safety_harness" background="#00BCD4" smart="true"/>
      <Label value="safety_shoes" background="#795548" smart="true"/>
      <Label value="employee_badge" background="#9C27B0" smart="true"/>
      <Label value="house_number_sign" background="#4CAF50" smart="true"/>
      <Label value="lat-long" background="#E91E63" smart="true"/>
    </KeyPointLabels>
  </View>

  <!-- SAM แบบกรอบ -->
  <View style="padding:12px; border:1px solid #00BCD4; margin-bottom:12px;">
    <Header value="3. SAM: เลือกคลาสแล้วลากกรอบรอบวัตถุ"/>

    <RectangleLabels
      name="sam_box"
      toName="image"
      smart="true"
      canRotate="false"
    >
      <Label value="person" background="#00B0FF" smart="true"/>
      <Label value="helmet" background="#FF9800" smart="true"/>
      <Label value="gloves" background="#8BC34A" smart="true"/>
      <Label value="safety_vest" background="#FFEB3B" smart="true"/>
      <Label value="safety_harness" background="#00BCD4" smart="true"/>
      <Label value="safety_shoes" background="#795548" smart="true"/>
      <Label value="employee_badge" background="#9C27B0" smart="true"/>
      <Label value="house_number_sign" background="#4CAF50" smart="true"/>
      <Label value="lat-long" background="#E91E63" smart="true"/>
    </RectangleLabels>
  </View>

  <!-- ข้อมูลบ้านเลขที่ -->
  <View
    visibleWhen="region-labels"
    whenLabelValue="house_number_sign"
    style="padding:12px; border:1px solid #4CAF50;"
  >
    <Header value="กรอกบ้านเลขที่ของ Mask ที่เลือก"/>
    <TextArea
      name="house_number"
      toName="image"
      perRegion="true"
      editable="true"
      rows="1"
      maxSubmissions="1"
      placeholder="ตัวอย่าง: 123/45"
    />
  </View>

  <Header value="ข้อมูล label เดิมสำหรับช่วยตรวจ"/>
  <Text name="legacy_info" value="$legacy_hint"/>
</View>